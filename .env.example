HOMESTEAD_PORT=7312
HOMESTEAD_IMAGE=ghcr.io/tbritton0826/homestead
HOMESTEAD_TAG=latest

# Use only behind a correctly configured HTTPS reverse proxy.
# HOMESTEAD_PUBLIC_ORIGIN=https://homestead.example.com

# Commercial accounts are opt-in and independent of local/media accounts.
HOMESTEAD_CUSTOMER_ENABLED=false
HOMESTEAD_CUSTOMER_ONLY=false
# HOMESTEAD_CUSTOMER_DATABASE_URL=postgresql://homestead_customer:URL_ENCODED_PASSWORD@customer-db:5432/homestead_customer
# CUSTOMER_DB_PASSWORD=configure-a-dedicated-secret
# HOMESTEAD_CUSTOMER_DB_TLS=true
# HOMESTEAD_CUSTOMER_ORIGIN=https://accounts.gethomesteadapp.com
# Exact cloudflared socket-peer IP(s) on the existing shared ingress network.
# Empty means no forwarded-header trust. No CIDRs, network aliases, true or hops.
HOMESTEAD_CUSTOMER_TRUSTED_PROXIES=
# HOMESTEAD_CUSTOMER_SMTP_URL=smtps://SMTP_USER:URL_ENCODED_PASSWORD@mail.example.com:465
# HOMESTEAD_CUSTOMER_MAIL_FROM=Homestead <accounts@gethomesteadapp.com>
# HOMESTEAD_CUSTOMER_MAIL_KEY=generate-32-random-bytes-as-64-hex-characters
HOMESTEAD_PAYMENT_MODE=test
# STRIPE_SECRET_KEY=configure-a-test-key-only
# STRIPE_WEBHOOK_SECRET=configure-your-test-endpoint-signing-secret
# HOMESTEAD_CUSTOMER_LICENSE_PRIVATE_KEY=configure-an-Ed25519-private-key

# Optional explicit Stripe TEST Customer Portal configuration
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_CONFIGURE_YOUR_TEST_PORTAL

# Artwork recovery retention (unprotected snapshots; protected/last valid points survive).
HOMESTEAD_ARTWORK_RECOVERY_MAX_SNAPSHOTS=20
HOMESTEAD_ARTWORK_RECOVERY_MAX_AGE_DAYS=30
HOMESTEAD_ARTWORK_RECOVERY_MAX_GB=5
